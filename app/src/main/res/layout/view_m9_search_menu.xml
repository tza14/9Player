<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/search_menu_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/search_prev_float"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="16dp"
        android:background="@drawable/reader_fab_bg"
        android:gravity="center"
        android:text="‹"
        android:textColor="#2C241B"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/search_next_float"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:background="@drawable/reader_fab_bg"
        android:gravity="center"
        android:text="›"
        android:textColor="#2C241B"
        android:textSize="32sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/search_info_bar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/reader_menu_panel_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageButton
                android:id="@+id/search_prev"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="@drawable/reader_menu_touch"
                android:src="@drawable/reader_ic_arrow_drop_up"
                app:tint="#2C241B" />

            <ImageButton
                android:id="@+id/search_next"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="@drawable/reader_menu_touch"
                android:src="@drawable/reader_ic_arrow_drop_down"
                app:tint="#2C241B" />

            <TextView
                android:id="@+id/search_info"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="#2C241B"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/search_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/reader_menu_panel_bg"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- 与 legado 的搜寻菜单一致：图标在上、文字在下（drawableTop + drawablePadding） -->
            <TextView
                android:id="@+id/search_results"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/reader_menu_touch"
                android:drawablePadding="3dp"
                android:drawableTint="#2C241B"
                android:includeFontPadding="false"
                android:drawableTop="@drawable/reader_ic_toc"
                android:gravity="center"
                android:paddingTop="6dp"
                android:text="@string/reader_search_results_action"
                android:textColor="#2C241B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/search_main_menu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/reader_menu_touch"
                android:drawablePadding="3dp"
                android:drawableTint="#2C241B"
                android:includeFontPadding="false"
                android:drawableTop="@drawable/reader_ic_menu"
                android:gravity="center"
                android:paddingTop="6dp"
                android:text="@string/reader_search_main_menu_action"
                android:textColor="#2C241B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/search_exit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/reader_menu_touch"
                android:drawablePadding="3dp"
                android:drawableTint="#2C241B"
                android:includeFontPadding="false"
                android:drawableTop="@drawable/reader_ic_close"
                android:gravity="center"
                android:paddingTop="6dp"
                android:text="@string/reader_search_exit_action"
                android:textColor="#2C241B"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
